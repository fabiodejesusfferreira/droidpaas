                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "api.apps.exemplo.com",
                    "www.api.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:20001"
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "blog.apps.exemplo.com",
                    "blog.exemplo.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "file_server",
